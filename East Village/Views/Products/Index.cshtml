@model IEnumerable<East_Village.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<a class="ScrollBtn hide" aria-label="Back to top" href="" id="js-top"></a>

<div class="col-md-12" style="padding-top: 15px;">

    @if (User.IsInRole("Admins"))
    {
        <a class="btn btn-outline-primary btn-block curved" href="/Products/Create">Create New</a>
    }
    <div class="table-responsive curved">
        <table class="table table-hover">

            @foreach (var item in Model)
            {
                <tr>
                    <td class="row text-center">
                        <div class="col-md-7 prodPad">
                            <img src="~/Uploads/@Html.DisplayFor(model => item.ProductImage)"
                                 class="curved" style="margin-bottom:30px; width:25rem; " />
                        </div>
                        <div class="col-md-5 ">
                            <h2>
                                @Html.DisplayFor(modelItem => item.Category.CategoryName)
                            </h2>
                            <br />
                            <h3>
                                @Html.DisplayFor(modelItem => item.ProductTitle)
                            </h3>
                            <br />
                            <h3>
                                @Html.DisplayFor(modelItem => item.ProductContent)
                            </h3>
                            <br />
                            @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-primary curved" })
                            <br />
                            <br />
                            @if (User.IsInRole("Admins"))
                            {

                                @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-info curved" })

                                @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger curved" })

                            }
                        </div>
                    </td>
                </tr>

            }
        </table>
    </div>
</div>

@section scripts{
    <script>
        const scrollToTopButton = document.getElementById('js-top');

        const scrollFunc = () => {
            let y = window.scrollY;

            if (y > 0) {
                scrollToTopButton.className = "ScrollBtn show";
            } else {
                scrollToTopButton.className = "ScrollBtn hide";
            }
        };

        window.addEventListener("scroll", scrollFunc);

        const scrollToTop = () => {
            const c = document.documentElement.scrollTop || document.body.scrollTop;

            if (c > 0) {
                window.requestAnimationFrame(scrollToTop);
                window.scrollTo(0, c - c / 10);
            }
        };

        scrollToTopButton.onclick = function (e) {
            e.preventDefault();
            scrollToTop();
        }
    </script>
}
