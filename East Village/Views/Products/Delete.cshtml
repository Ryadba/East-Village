@model East_Village.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="col-md-6 offset-md-3 curved" style="padding-top: 8px; margin-top: 8px;">

    <h2 class="text-center">Delete Product</h2>

    <hr />
    <div class="row">
        <div class="col-md-6">
            <br />
            <br />
            <h5>
                @Html.DisplayNameFor(model => model.Category.CategoryName)
            </h5>

            <h3>
                @Html.DisplayFor(model => model.Category.CategoryName)
            </h3>

            <h5>
                @Html.DisplayNameFor(model => model.ProductTitle)
            </h5>

            <h3>
                @Html.DisplayFor(model => model.ProductTitle)
            </h3>

            <h5>
                @Html.DisplayNameFor(model => model.ProductContent)
            </h5>

            <h3>
                @Html.DisplayFor(model => model.ProductContent)
            </h3>
        </div>

        <div class="col-md-6">
            <h3 class="text-center">Are you sure you want to delete this?</h3>
            <br />
            <img src="~/Uploads/@Html.DisplayFor(model => model.ProductImage)"
                 class="thumbnail" style="width:250px; height:250px;" />
        </div>
        <div class="col-md-6">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions no-color">
                    <input type="submit" value="Delete" class="btn btn-danger btn-lg" />
                    &nbsp;
                    <a href="~/Products" class="btn btn-light btn-lg">Back to List</a>
                </div>
            }
        </div>
    </div>
</div>