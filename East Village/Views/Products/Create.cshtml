@model East_Village.Models.Product

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="col-md-6 offset-md-3 curved" style="padding-top: 8px; margin-top: 8px;">

    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <h2 class="text-center">Create New <br />Product</h2>
        <div class="alert alert-danger" id="error-div" style="display:none;">
            <span id="view-err">

            </span>
        </div>
        <br />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ProductImage)
        <div class="form-group row">
            @Html.LabelFor(model => model.ProductTitle, htmlAttributes: new { @class = "col-form-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ProductTitle, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProductTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.ProductContent, htmlAttributes: new { @class = "col-form-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ProductContent, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProductContent, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.ProductImage, htmlAttributes: new { @class = "col-form-label col-md-2" })
            <div class="col-md-10">
                @*AlRiO Custom file Input Start*@
                <input type="file" name="upload" id="myImage" />
                <label class="custom-file-label" for="myImage"></label>
                <div class="custom-filename" id="myImage-filename"></div>
                @*AlRiO Custom file Input End*@
                @Html.ValidationMessageFor(model => model.ProductImage, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.CategoryId, "Category", htmlAttributes: new { @class = "col-form-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("CategoryId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group text-center">
            <input type="submit" value="Create" class="btn btn-secondary btn-lg" id="create" />
            &nbsp;
            <a href="~/Products" class="btn btn-light btn-lg">Back to List</a>
        </div>
    }
</div>

@section scripts{
    <script>
        $(function () {
            $("#create").click(function () {

                //Check if the input Empty
                if ($("#myImage").val() == "") {
                    $("#error-div").show();
                    $("#view-err").append("Please choose an image to Upload");

                    return false;
                }

                if ($("#myImage").val() != "") {
                    //Check if the Image extension is valid
                    var filename = document.getElementById("myImage").value;
                    var extensionImg = filename.substr(filename.lastIndexOf('.') + 1);
                    var validExtensions = ['jpg', 'jpeg', 'gif', 'bmp', 'png'];
                    if ($.inArray(extensionImg, validExtensions) == -1) {
                        $("#error-div").show();
                        $("#view-err").append("Please choose a valid image extension to Upload");
                        return false;
                    }

                    //Check if the Image Size is valid (2 mb)
                    var myFileSize = document.getElementById("myImage").files[0].size / 1024 / 1024;

                    if (myFileSize > 2) {
                        $("#error-div").show();
                        $("#view-err").append("Please choose a valid image size (2MB Max File Size)");
                        return false;
                    }
                }
            });
        });
    </script>
    @*AlRiO Custom file Input Start*@
    <script>
        var input = document.getElementById('myImage');
        var infoArea = document.getElementById('myImage-filename');

        input.addEventListener('change', showFileName);

        function showFileName(event) {

            var input = event.srcElement;

            var fileName = input.files[0].name;

            infoArea.textContent = fileName;
        }
    </script>
    @*AlRiO Custom file Input End*@
}
