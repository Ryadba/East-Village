@model East_Village.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-6 offset-md-3 curved" style="padding-top: 8px; padding-bottom: 8px;  margin-top: 8px;">

    <h1 class="card-header text-center" style="border: 2px solid #e9eeff; border-radius: 22px;">Are you sure you want to delete this Category?</h1>

    <hr />
    <div>
        <h5>
            @Html.DisplayNameFor(model => model.CategoryName)
        </h5>
        <h3>
            @Html.DisplayFor(model => model.CategoryName)
        </h3>
        <br />
        <h5>
            @Html.DisplayNameFor(model => model.CategoryDescription)
        </h5>
        <h3>
            @Html.DisplayFor(model => model.CategoryDescription)
        </h3>
    </div>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

    <div class="form-actions no-color">
        <input type="submit" value="Delete" class="btn btn-danger btn-block btn-lg curved" />
        <br />
        <a href="~/Categories" class="btn btn-light btn-block btn-lg curved">Back to List</a>
    </div>
    }
</div>
