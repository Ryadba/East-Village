<!-- Banner end -->

<a class="ScrollBtn hide" aria-label="Back to top" href="" id="js-top"></a>

@foreach (var item in Model)
{
    <div class=" col-md-6 text-center">
        <div class="card curved" style="margin-top:5px; margin-bottom:8px; padding:10px; background-color: rgba(255,255,255,0.6)">
            <div class="card-header" style="border: 2px solid #e9eeff; border-radius: 22px;"><h1>@Html.DisplayFor(modelItem => item.CategoryName)</h1></div>
            <h5 style="margin-top:8px;">@Html.DisplayFor(modelItem => item.CategoryDescription)</h5>
            <div class="card-body row">
                @foreach (var subItem in item.Products)
                {
                    <div class="col-lg-6 img-thumbnail curved" style="margin-bottom:8px; ">
                        <img src="~/Uploads/@subItem.ProductImage" style=" width:15.625rem; height:15.625rem;" />
                        <h3 class="card-title">@Html.DisplayFor(modelItem => subItem.ProductTitle)</h3>
                        @*<h5 class="card-text">@Html.DisplayFor(modelItem => subItem.ProductContent)</h5>*@
                        @Html.ActionLink("Details", "Details", new { ProductId = subItem.Id }, new { @class = "btn btn-outline-primary", @style = "border-radius: 22px;" })

                    </div>
                }
            </div>
        </div>
    </div>
}


@section scripts{
    <script>
        const scrollToTopButton = document.getElementById('js-top');

        const scrollFunc = () => {
            let y = window.scrollY;

            if (y > 0) {
                scrollToTopButton.className = "ScrollBtn show";
            } else {
                scrollToTopButton.className = "ScrollBtn hide";
            }
        };

        window.addEventListener("scroll", scrollFunc);

        const scrollToTop = () => {
            const c = document.documentElement.scrollTop || document.body.scrollTop;

            if (c > 0) {
                window.requestAnimationFrame(scrollToTop);
                window.scrollTo(0, c - c / 10);
            }
        };

        scrollToTopButton.onclick = function (e) {
            e.preventDefault();
            scrollToTop();
        }
    </script>
}