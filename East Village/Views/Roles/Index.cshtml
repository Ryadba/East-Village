@model IEnumerable<Microsoft.AspNet.Identity.EntityFramework.IdentityRole>


<div class="text-center col-md-6 offset-md-3" style="margin-top:8px; background-color: rgba(255,255,255,0.6)">
    <div class="card-header" style="border: 2px solid #e9eeff; border-radius: 22px;"><h2>Roles</h2></div>
</div>
 
<a class="btn btn-outline-primary btn-block btn-lg curved" href="/Roles/Create">Create New</a>
<table class="table table-stripped table-bordered table-hover" style="background-color:white;">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
