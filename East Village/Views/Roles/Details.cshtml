@model Microsoft.AspNet.Identity.EntityFramework.IdentityRole




<div class="col-md-6 offset-md-3 curved" style="padding-top: 8px; margin-top: 8px;">

    <h2 class="card-header text-center" style="border: 2px solid #e9eeff; border-radius: 22px;">Role Details</h2>

    <hr />
    <div>
        <h5>
            @Html.DisplayNameFor(model => model.Name)
        </h5>
        <br />
        <h3>
            @Html.DisplayFor(model => model.Name)
        </h3>
    </div>
    <hr />

    @if (User.IsInRole("Admins"))
    {
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-info btn-block btn-lg curved" })
    }
    <br />
    <a href="~/Roles" class="btn btn-light btn-block btn-lg curved">Back to List</a>
    <br />

</div>
