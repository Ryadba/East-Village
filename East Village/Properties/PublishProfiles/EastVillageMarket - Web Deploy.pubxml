<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://eastvillagemarket.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>eastvillagemarket.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>EastVillageMarket</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <InstallAspNetCoreSiteExtension>False</InstallAspNetCoreSiteExtension>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>$EastVillageMarket</UserName>
    <_SavePWD>True</_SavePWD>
    <_DestinationType>AzureWebSite</_DestinationType>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="DefaultConnection" Order="1" Enabled="False">
          <Destination Path="&lt;add name=&quot;DefaultConnection&quot; connectionString=&quot;Server=tcp:eastvillagemarket.database.windows.net,1433;Initial Catalog=EVMDB;Persist Security Info=False;User ID=evm99;Password=Kareem_h;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;&quot; providerName=&quot;System.Data.SqlClient&quot; /&gt;" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="WebApplication2.Models.ApplicationDbContext, East Village" MigrationConfiguration="East_Village.Migrations.Configuration, East Village" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="DefaultConnection-Web.config Connection String">
      <ParameterValue>
        <add name="DefaultConnection" connectionString="Server=tcp:eastvillagemarket.database.windows.net,1433;Initial Catalog=EVMDB;Persist Security Info=False;User ID=evm99;Password=Kareem_h;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" providerName="System.Data.SqlClient" xmlns="" />
      </ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>